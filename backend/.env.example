# ── TokenWalla Backend Environment (template) ────────────────────────────────
# Copy to backend/.env and fill in real values:  cp backend/.env.example backend/.env
# The real backend/.env is gitignored — never commit it.

# ── Django Core ───────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string

# DEBUG defaults to False (secure-by-default) if this is unset. For LOCAL DEV you
# MUST set it to True — otherwise SECURE_SSL_REDIRECT + secure cookies turn on and
# http://localhost stops working (redirect to https the dev server can't serve).
DEBUG=True

# With DEBUG=False (staging/production) Django strictly enforces ALLOWED_HOSTS.
# List every host that serves the app or all requests get HTTP 400. Comma-separated.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# e.g. production:  ALLOWED_HOSTS=your-app.up.railway.app,api.yourdomain.com

# CORS — allowed frontend origin(s), comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Database / Cache ──────────────────────────────────────────────────────────
# DATABASE_URL wins if set; otherwise the DB_* fallbacks in settings.py are used.
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0

# ── Cloudinary (leave blank to use local file storage in dev) ─────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Cashfree Payment Gateway (patient checkout) ───────────────────────────────
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=SANDBOX
# Webhook signing secret (defaults to CASHFREE_CLIENT_SECRET if left blank).
CASHFREE_WEBHOOK_SECRET=

# ── Cashfree Payouts (doctor settlement) ──────────────────────────────────────
# Keep disabled until Payouts KYC is live; payouts are simulated while off.
#
# PAYOUTS 2FA IS MANDATORY — unlike the Payment Gateway above, EVERY Payouts API
# call (sandbox included) is refused with 403 "IP not whitelisted" until the
# caller passes one of the two gates below. Valid keys are NOT enough.
# Webhooks are unaffected (inbound, HMAC-signed).
#   1. Static IP  → whitelist the server that runs `manage.py run_daily_payouts`
#                   under Payouts Dashboard → Developers → Two-Factor
#                   Authentication, and leave the public key below blank.
#   2. Dynamic IP → set CASHFREE_PAYOUT_PUBLIC_KEY (Railway's egress IP is not
#                   static, so this is the one you want in production).
CASHFREE_PAYOUTS_ENABLED=false
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=
# Payouts webhooks are signed with CASHFREE_PAYOUT_CLIENT_SECRET itself —
# Cashfree has no separate webhook secret for Payouts. Only set this if you
# rotate the client secret above (Cashfree signs with the oldest still-active
# one during the rotation window). Leave blank normally.
CASHFREE_PAYOUT_WEBHOOK_SECRET=
# Payouts 2FA public key (see gate 2 above). Download it from Payouts Dashboard
# → Developers → Two-Factor Authentication and paste the PEM contents here, or
# give a path to the .pem file. When set, an X-Cf-Signature header is sent on
# every Payouts call and no IP whitelisting is needed. Blank ⇒ IP gate only.
CASHFREE_PAYOUT_PUBLIC_KEY=

# ── 2Factor OTP ───────────────────────────────────────────────────────────────
# Leave BLANK for dev mode (the OTP is printed to the server console instead of
# being sent). Set your 2factor.in key to send real SMS/voice OTPs.
TWOFACTOR_API_KEY=

# ── Admin bootstrap ───────────────────────────────────────────────────────────
# Required by /api/auth/create-admin/ ; leave blank to disable admin self-setup.
ADMIN_SETUP_KEY=

# ── Logging ───────────────────────────────────────────────────────────────────
DJANGO_LOG_LEVEL=WARNING

# ── WhatsApp (optional notifications) ─────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_BOOKING_CONFIRM=booking_confirmation
WHATSAPP_TEMPLATE_REMINDER=appointment_reminder
WHATSAPP_TEMPLATE_LANG=en
