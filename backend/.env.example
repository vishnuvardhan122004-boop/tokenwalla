# ── TokenWalla Backend Environment (template) ────────────────────────────────
# Copy to backend/.env and fill in real values:  cp backend/.env.example backend/.env
# The real backend/.env is gitignored — never commit it.

# ── Django Core ───────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string

# DEBUG defaults to False (secure-by-default) if this is unset. For LOCAL DEV you
# MUST set it to True — otherwise SECURE_SSL_REDIRECT + secure cookies turn on and
# http://localhost stops working (redirect to https the dev server can't serve).
DEBUG=True

# With DEBUG=False (staging/production) Django strictly enforces ALLOWED_HOSTS.
# List every host that serves the app or all requests get HTTP 400. Comma-separated.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# e.g. production:  ALLOWED_HOSTS=your-app.up.railway.app,api.yourdomain.com

# CORS — allowed frontend origin(s), comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Database / Cache ──────────────────────────────────────────────────────────
# DATABASE_URL wins if set; otherwise the DB_* fallbacks in settings.py are used.
DATABASE_URL=
# Cache. Leave USE_REDIS_CACHE unset locally — the cache then uses the database
# table and needs nothing running. Set it to True ONLY on a service that has a
# Redis addon attached; REDIS_URL on its own is deliberately ignored, so a
# stale value here can't silently point the cache at a Redis nobody is running.
# USE_REDIS_CACHE=True
# REDIS_URL=redis://...

# ── Cloudinary (leave blank to use local file storage in dev) ─────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Razorpay Payment Gateway (patient checkout) ───────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Doctor payouts ─────────────────────────────────────────────────────────────
# Manual — no gateway keys needed. Staff wire the money from TokenWalla's own
# bank account and mark it paid on the admin payouts page. See
# payments.payout_utils and payments.views.MarkPayoutPaidView.

# ── 2Factor OTP ───────────────────────────────────────────────────────────────
# Leave BLANK for dev mode (the OTP is printed to the server console instead of
# being sent). Set your 2factor.in key to send real SMS/voice OTPs.
TWOFACTOR_API_KEY=

# ── Admin bootstrap ───────────────────────────────────────────────────────────
# Required by /api/auth/create-admin/ ; leave blank to disable admin self-setup.
ADMIN_SETUP_KEY=

# ── Logging ───────────────────────────────────────────────────────────────────
DJANGO_LOG_LEVEL=WARNING

# ── WhatsApp (optional notifications) ─────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_BOOKING_CONFIRM=booking_confirmation
WHATSAPP_TEMPLATE_REMINDER=appointment_reminder
WHATSAPP_TEMPLATE_LANG=en
